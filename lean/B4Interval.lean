/-
B-4 (iii), step 1 (2026-10-10): the interval lemma. For log q ∈ [l0, l1], specialize
`b4_elementary_zero_gap` to N = 2^k, H = 2^(3j), y = 2^m and use monotonicity in ℓ = log q:
the coefficient 2η²ℓe^{-η}/L² increases and the bracket decreases. What remains is the closed
numerical expression `cvalExpr`, in log 2, exp η and rationals only, which LeanCert certifies
(file B4Certificates.lean, generated by computations/lean_grid.gp).
Arguments of `cvalExpr`: K = k, J = j, P = 2^(3j) = H, Q = 4^j = H^(2/3), the ramified bound Rb.
Build: see README.md.
-/
import B4ElementaryGap

namespace B4

/-- the bracket at `ℓ = l1`, with `1/⌊U⌋ ≤ 1/1000`, `Z ≤ 2η/(eL)`, `(3/2)L/U ≤ 1/1000` -/
noncomputable def brExpr (K J P Q Rb η l1 : ℝ) : ℝ :=
  4 / 3 * K * Real.log 2 - (1 + (5 * Real.log 2 + 3) / 4 + 1 / 1000)
    - Real.exp η * (l1 / 4 + η * Real.exp (-1) / (4 / 3 * K * Real.log 2)) - Rb
    - (3 * J + 2) * Real.log 2
    - (1 + 192 * (4 * 97 ^ 2) / P) * ((K + 3) * Real.log 2 + l1 / 2)
    - 4 * 97 ^ 2 * (2 * Real.log 2 + 1 / 1000) / Q

/-- the certified constant on `[l0, l1]` -/
noncomputable def cvalExpr (K J P Q Rb η l0 l1 : ℝ) : ℝ :=
  2 * η ^ 2 * l0 * Real.exp (-η) / (4 / 3 * K * Real.log 2) ^ 2 * brExpr K J P Q Rb η l1

/-- the certificate, division-free and with products instead of powers (LeanCert's reifier does
not accept `x ^ 3` for non-numeral `x`): `c·L³ ≤ 2η²l0e^{-η}·(L·br)`, `L = 4/3·K·log 2`. -/
def certProp (K J P Q Rb η l0 l1 c : ℝ) : Prop :=
  c * ((4 / 3 * K * Real.log 2) * (4 / 3 * K * Real.log 2) * (4 / 3 * K * Real.log 2)) ≤
    2 * η * η * l0 * Real.exp (-η) *
      ((4 / 3 * K * Real.log 2) * (4 / 3 * K * Real.log 2 - (1 + (5 * Real.log 2 + 3) / 4 + 1 / 1000)
          - Rb - (3 * J + 2) * Real.log 2
          - (1 + 192 * (4 * 97 ^ 2) / P) * ((K + 3) * Real.log 2 + l1 / 2)
          - 4 * 97 ^ 2 * (2 * Real.log 2 + 1 / 1000) / Q)
        - Real.exp η * (l1 / 4 * (4 / 3 * K * Real.log 2) + η * Real.exp (-1)))

theorem cval_of_cert {K J P Q Rb η l0 l1 c : ℝ} (hK : 0 < K) (h : certProp K J P Q Rb η l0 l1 c) :
    c ≤ cvalExpr K J P Q Rb η l0 l1 := by
  have hL : 0 < 4 / 3 * K * Real.log 2 := by
    have := Real.log_pos (show (1 : ℝ) < 2 by norm_num); positivity
  unfold certProp at h
  unfold cvalExpr brExpr
  set L := 4 / 3 * K * Real.log 2
  have hL3 : 0 < L * L * L := by positivity
  have heq : 2 * η ^ 2 * l0 * Real.exp (-η) / L ^ 2 *
      (L - (1 + (5 * Real.log 2 + 3) / 4 + 1 / 1000) - Real.exp η * (l1 / 4 + η * Real.exp (-1) / L)
        - Rb - (3 * J + 2) * Real.log 2 - (1 + 192 * (4 * 97 ^ 2) / P) * ((K + 3) * Real.log 2 + l1 / 2)
        - 4 * 97 ^ 2 * (2 * Real.log 2 + 1 / 1000) / Q) =
      (2 * η * η * l0 * Real.exp (-η) *
        (L * (L - (1 + (5 * Real.log 2 + 3) / 4 + 1 / 1000) - Rb - (3 * J + 2) * Real.log 2
          - (1 + 192 * (4 * 97 ^ 2) / P) * ((K + 3) * Real.log 2 + l1 / 2)
          - 4 * 97 ^ 2 * (2 * Real.log 2 + 1 / 1000) / Q)
        - Real.exp η * (l1 / 4 * L + η * Real.exp (-1)))) / (L * L * L) := by
    field_simp
    ring
  rw [heq, le_div_iff₀ hL3]
  exact h

theorem two_pow_ge (k : ℕ) (hk : 15 ≤ k) : k * 2000 ≤ 2 ^ k := by
  induction k, hk using Nat.le_induction with
  | base => norm_num
  | succ n hn ih =>
    rw [pow_succ]
    have h1 : 15 * 2000 ≤ n * 2000 := Nat.mul_le_mul_right _ hn
    linarith

set_option maxHeartbeats 4000000 in
open OAI.SiegelZeros.WeightedTorusJets in
/-- **Core lemma**: for `log q ≤ l1`, the coefficient at `ℓ = log q` times the bracket `brExpr` at
`l1` is `≤ (1-β) log q` (whatever the sign of the bracket). -/
theorem core_gap
    (q : ℕ) [NeZero q] (hq : 3 ≤ q) (hq8 : q ≠ 8)
    (χ : DirichletCharacter ℂ q) (hreal : ∀ x : ZMod q, (χ x).im = 0)
    (hprim : χ.IsPrimitive) (hne : χ ≠ 1)
    (β : ℝ) (hβ0 : 0 < β) (hβ1 : β < 1) (hzero : DirichletCharacter.LFunction χ (β : ℂ) = 0)
    (k j m : ℕ) (hk : 15 ≤ k) (hj : 1 ≤ j) (hjk : 3 * j ≤ k)
    (η l1 Rb : ℝ) (hη : 0 < η) (hη13 : η ≤ 13) (hℓ1 : Real.log q ≤ l1)
    (hRb : l1 ≤ Rb ∨ ((m : ℝ) + 2) * Real.log 2 + l1 / 2 ^ m ≤ Rb) :
    2 * η ^ 2 * Real.log q * Real.exp (-η) / (4 / 3 * (k : ℝ) * Real.log 2) ^ 2 *
        brExpr k j ((2 : ℝ) ^ (3 * j)) ((4 : ℝ) ^ j) Rb η l1 ≤ (1 - β) * Real.log q := by
  -- the parameters
  set N : ℕ := 2 ^ k with hNdef
  set H : ℕ := 2 ^ (3 * j) with hHdef
  have hH2 : 2 ≤ H := by
    have : 2 ^ 1 ≤ 2 ^ (3 * j) := Nat.pow_le_pow_right (by norm_num) (by omega)
    simpa [hHdef] using this
  have hHN : H ≤ N := Nat.pow_le_pow_right (by norm_num) hjk
  have hN : 18818 ≤ N := by
    have : 2 ^ 15 ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) hk
    simp only [hNdef]; omega
  have hlog2 : 0.6931471803 < Real.log 2 := Real.log_two_gt_d9
  have hlog2' : Real.log 2 < 0.6931471808 := Real.log_two_lt_d9
  have hkr : (15 : ℝ) ≤ k := by exact_mod_cast hk
  have hNr : (N : ℝ) = 2 ^ k := by simp [hNdef]
  have hNpos : (0 : ℝ) < N := by rw [hNr]; positivity
  have hLeq : Real.log ((N : ℝ) ^ (4 / 3 : ℝ)) = 4 / 3 * k * Real.log 2 := by
    rw [Real.log_rpow hNpos, hNr, Real.log_pow]; ring
  set L := 4 / 3 * (k : ℝ) * Real.log 2 with hL
  have hLpos : 0 < L := by positivity
  have hηL : η ≤ Real.log ((N : ℝ) ^ (4 / 3 : ℝ)) := by
    rw [hLeq]; nlinarith
  have hy : (1 : ℝ) ≤ 2 ^ m := one_le_pow₀ (by norm_num)
  have h := b4_elementary_zero_gap q hq hq8 χ hreal hprim hne β hβ0 hβ1 hzero N H hH2 hHN hN
    η (2 ^ m) hη hηL hy
  dsimp only at h
  rw [hLeq] at h
  -- now compare the bracket with brExpr at l1
  set ℓ := Real.log q with hℓ
  have hℓpos : 0 < ℓ := Real.log_pos (by exact_mod_cast (show 1 < q by omega))
  set U : ℝ := (N : ℝ) ^ (4 / 3 : ℝ) with hU
  have hNU : (N : ℝ) ≤ U := by
    rw [hU]; exact Real.self_le_rpow_of_one_le (by rw [hNr]; exact one_le_pow₀ (by norm_num))
      (by norm_num)
  have hN1000 : (1000 : ℝ) ≤ N := by exact_mod_cast (show 1000 ≤ N by omega)
  have hUpos : 0 < U := by linarith
  -- 1/⌊U⌋ ≤ 1/1000
  have hfloor : 1 / (⌊U⌋₊ : ℝ) ≤ 1 / 1000 := by
    have : (1000 : ℝ) ≤ ⌊U⌋₊ := by
      have h1 : N ≤ ⌊U⌋₊ := Nat.le_floor (by exact_mod_cast hNU)
      exact_mod_cast (show 1000 ≤ ⌊U⌋₊ by omega)
    exact one_div_le_one_div_of_le (by norm_num) this
  -- Z ≤ 2η/(eL)
  have hZ : 2 * ((1 + η / L) - 1) * Real.exp (-1) / (1 + η / L) ≤ 2 * (η / L) * Real.exp (-1) := by
    have h1 : 1 ≤ 1 + η / L := by have := div_pos hη hLpos; linarith
    rw [show (1 + η / L) - 1 = η / L by ring]
    exact div_le_self (by positivity) h1
  -- R ≤ Rb
  have hR : min ℓ (Real.log (2 ^ m) + Real.log 4 + ℓ / 2 ^ m) ≤ Rb := by
    rcases hRb with h1 | h1
    · exact (min_le_left _ _).trans (hℓ1.trans h1)
    · refine (min_le_right _ _).trans (le_trans ?_ h1)
      rw [Real.log_pow, show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
      have : ℓ / 2 ^ m ≤ l1 / 2 ^ m := div_le_div_of_nonneg_right hℓ1 (by positivity)
      push_cast; linarith
  -- LH, ρ, size
  have hHr : (H : ℝ) = 2 ^ (3 * j) := by simp [hHdef]
  have hLH : Real.log H + Real.log 4 = (3 * j + 2) * Real.log 2 := by
    rw [hHr, Real.log_pow, show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; ring
  have hsize : Real.log N + 1 / 2 * ℓ + Real.log 8 ≤ (k + 3) * Real.log 2 + l1 / 2 := by
    rw [hNr, Real.log_pow, show (8 : ℝ) = 2 ^ 3 by norm_num, Real.log_pow]; push_cast; linarith
  have hsize0 : 0 ≤ Real.log N + 1 / 2 * ℓ + Real.log 8 := by
    have : 0 ≤ Real.log (N : ℝ) := Real.log_nonneg (by linarith)
    have : 0 ≤ Real.log (8 : ℝ) := Real.log_nonneg (by norm_num)
    linarith
  -- the W term
  have hH23 : (H : ℝ) ^ (2 / 3 : ℝ) = 4 ^ j := by
    rw [hHr, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]
    rw [show ((3 * j : ℕ) : ℝ) * (2 / 3) = ((2 * j : ℕ) : ℝ) by push_cast; ring, Real.rpow_natCast,
      pow_mul]
    norm_num
  have hLU : 3 / 2 * L ≤ U / 1000 := by
    have h2k : (k : ℝ) * 2000 ≤ 2 ^ k := by exact_mod_cast two_pow_ge k hk
    have : L ≤ k := by
      simp only [hL]
      nlinarith [mul_le_mul_of_nonneg_left hlog2'.le (by positivity : (0 : ℝ) ≤ k)]
    rw [← hNr] at h2k
    linarith
  have hW : (Real.log 4 * U + 3 / 2 * L) * ((4 * 97 ^ 2) / ((H : ℝ) ^ (2 / 3 : ℝ) * U)) ≤
      4 * 97 ^ 2 * (2 * Real.log 2 + 1 / 1000) / (4 : ℝ) ^ j := by
    rw [hH23, show Real.log 4 = 2 * Real.log 2 by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; ring]
    have h4 : (0 : ℝ) < 4 ^ j := by positivity
    have hfrac : (3 / 2 * L) / U ≤ 1 / 1000 := by rw [div_le_iff₀ hUpos]; linarith
    have heq : (2 * Real.log 2 * U + 3 / 2 * L) * ((4 * 97 ^ 2) / ((4 : ℝ) ^ j * U)) =
        4 * 97 ^ 2 * (2 * Real.log 2 + (3 / 2 * L) / U) / (4 : ℝ) ^ j := by
      field_simp
    rw [heq]
    apply div_le_div_of_nonneg_right _ h4.le
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    linarith
  -- the bracket
  set B := brExpr k j ((2 : ℝ) ^ (3 * j)) ((4 : ℝ) ^ j) Rb η l1 with hB
  have hρ : (192 * (4 * 97 ^ 2) / (H : ℝ)) = 192 * (4 * 97 ^ 2) / (2 : ℝ) ^ (3 * j) := by rw [hHr]
  have hρ0 : 0 ≤ 1 + 192 * (4 * 97 ^ 2) / (H : ℝ) := by positivity
  have he : 0 < Real.exp η := Real.exp_pos η
  have hbr : B ≤ L - (1 + (5 * Real.log 2 + 3) / 4 + 1 / (⌊U⌋₊ : ℝ))
      - Real.exp η * (ℓ / 4 + (2 * ((1 + η / L) - 1) * Real.exp (-1) / (1 + η / L) + 0) / 2)
      - min ℓ (Real.log (2 ^ m) + Real.log 4 + ℓ / 2 ^ m) - (Real.log H + Real.log 4)
      - (1 + 192 * (4 * 97 ^ 2) / (H : ℝ)) * (Real.log N + 1 / 2 * Real.log q + Real.log 8)
      - (Real.log 4 * U + 3 / 2 * L) * ((4 * 97 ^ 2) / ((H : ℝ) ^ (2 / 3 : ℝ) * U)) := by
    simp only [hB, brExpr]
    rw [hLH, ← hρ]
    have h1 : Real.exp η * (ℓ / 4 + (2 * ((1 + η / L) - 1) * Real.exp (-1) / (1 + η / L) + 0) / 2)
        ≤ Real.exp η * (l1 / 4 + η * Real.exp (-1) / L) := by
      apply mul_le_mul_of_nonneg_left _ he.le
      have : η * Real.exp (-1) / L = (2 * (η / L) * Real.exp (-1)) / 2 := by ring
      rw [this]; linarith
    have h2 := mul_le_mul_of_nonneg_left hsize hρ0
    nlinarith
  calc 2 * η ^ 2 * ℓ * Real.exp (-η) / L ^ 2 * B
      ≤ _ := mul_le_mul_of_nonneg_left hbr (by positivity)
    _ ≤ _ := h

#print axioms core_gap

open OAI.SiegelZeros.WeightedTorusJets in
/-- **Interval lemma.** -/
theorem interval_gap
    (q : ℕ) [NeZero q] (hq : 3 ≤ q) (hq8 : q ≠ 8)
    (χ : DirichletCharacter ℂ q) (hreal : ∀ x : ZMod q, (χ x).im = 0)
    (hprim : χ.IsPrimitive) (hne : χ ≠ 1)
    (β : ℝ) (hβ0 : 0 < β) (hβ1 : β < 1) (hzero : DirichletCharacter.LFunction χ (β : ℂ) = 0)
    (k j m : ℕ) (hk : 15 ≤ k) (hj : 1 ≤ j) (hjk : 3 * j ≤ k)
    (η l0 l1 Rb c : ℝ) (hη : 0 < η) (hη13 : η ≤ 13) (hl0 : 0 < l0)
    (hℓ0 : l0 ≤ Real.log q) (hℓ1 : Real.log q ≤ l1)
    (hRb : l1 ≤ Rb ∨ ((m : ℝ) + 2) * Real.log 2 + l1 / 2 ^ m ≤ Rb)
    (P Q : ℝ) (hP : P = 2 ^ (3 * j)) (hQ : Q = 4 ^ j)
    (hc : 0 < c) (hcert' : certProp k j P Q Rb η l0 l1 c) :
    c ≤ (1 - β) * Real.log q := by
  subst hP hQ
  have hcert := cval_of_cert (by exact_mod_cast (show 0 < k by omega)) hcert'
  have h := core_gap q hq hq8 χ hreal hprim hne β hβ0 hβ1 hzero k j m hk hj hjk η l1 Rb hη hη13 hℓ1 hRb
  set B := brExpr k j ((2 : ℝ) ^ (3 * j)) ((4 : ℝ) ^ j) Rb η l1 with hB
  set L := 4 / 3 * (k : ℝ) * Real.log 2 with hL
  have hLpos : 0 < L := by
    have := Real.log_pos (show (1 : ℝ) < 2 by norm_num)
    have : (0 : ℝ) < k := by exact_mod_cast (show 0 < k by omega)
    positivity
  have hcoef0 : 0 < 2 * η ^ 2 * l0 * Real.exp (-η) / L ^ 2 := by positivity
  have hB0 : 0 ≤ B := by
    by_contra hneg
    replace hneg := not_le.mp hneg
    have : cvalExpr k j ((2 : ℝ) ^ (3 * j)) ((4 : ℝ) ^ j) Rb η l0 l1 < 0 := by
      simp only [cvalExpr]; rw [← hB]; exact mul_neg_of_pos_of_neg hcoef0 hneg
    linarith
  have hcoef : 2 * η ^ 2 * l0 * Real.exp (-η) / L ^ 2 ≤
      2 * η ^ 2 * Real.log q * Real.exp (-η) / L ^ 2 := by
    gcongr
  calc c ≤ cvalExpr k j ((2 : ℝ) ^ (3 * j)) ((4 : ℝ) ^ j) Rb η l0 l1 := hcert
    _ = 2 * η ^ 2 * l0 * Real.exp (-η) / L ^ 2 * B := by simp only [cvalExpr, hB, hL]
    _ ≤ 2 * η ^ 2 * Real.log q * Real.exp (-η) / L ^ 2 * B := mul_le_mul_of_nonneg_right hcoef hB0
    _ ≤ _ := h

#print axioms interval_gap

end B4
