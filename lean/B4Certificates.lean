theorem log_three_ge : (5493/5000 : ℝ) ≤ Real.log 3 := by leancert (trust := kernel)

/-- **Explicit zero gap, all q ≥ 3, q ≠ 8** (elementary inputs, upstream counting). -/
theorem zero_gap_all (q : ℕ) [NeZero q] (hq : 3 ≤ q) (hq8 : q ≠ 8) (χ : DirichletCharacter ℂ q)
    (hreal : ∀ x : ZMod q, (χ x).im = 0) (hprim : χ.IsPrimitive) (hne : χ ≠ 1) (β : ℝ) (hβ0 : 0 < β)
    (hβ1 : β < 1) (hzero : DirichletCharacter.LFunction χ (β : ℂ) = 0) :
    (5811/10000000 : ℝ) ≤ (1 - β) * Real.log q :=
  chain_1 q hq hq8 χ hreal hprim hne β hβ0 hβ1 hzero
    (log_three_ge.trans (Real.log_le_log (by norm_num) (by exact_mod_cast hq)))

