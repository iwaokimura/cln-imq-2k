\\ (2026-10-10): generates lean/B4ClassCert.lean. For each N, the closed inequalities of
\\ h_bound_of_gap (lean/B4ClassBound.lean) are split into atomic bounds exp(...) <= u (or >= l),
\\ each proved by LeanCert (kernel), and combined by gcongr / norm_num. A = 10^6, V = 10^4
\\ (Proposition 9 of the paper). Rationals: 12 significant digits, rounded outward with relative slack 1e-9.
\\ Run: gp -q lean_h_cert.gp < /dev/null > lean_h_cert.txt

if(default(realprecision) < 60, default(realprecision, 60));
if(type(LEANOUT) != "t_STR", LEANOUT = "../lean/B4ClassCert.lean");

rup(v) = {
  my(e = floor(log(abs(v))/log(10)) - 11, w = v*(1 + 10^-9));
  return(ceil(w/10^e)*10^e);
};
rdown(v) = {
  my(e = floor(log(abs(v))/log(10)) - 11, w = v*(1 - 10^-9));
  return(floor(w/10^e)*10^e);
};

\\ Lean spellings of the parameters, exactly as they appear after unfolding classEps / classP
lc(c) = Str("(", c, " : ℝ)");

run() = {
  my(tab = [[100, 286787/10000, 2753/500000], [200, 150729/5000, 2811/500000],
            [500, 160029/5000, 5759/1000000], [1000, 334757/10000, 5861/1000000], [2000, 350131/10000, 1193/200000]],
     A = 1000000, V = 10000, fd, N, T, c, sT, P, v, u, l, eu, rhs, cs, Ts, As, Vs, names, exprs, vals, ups, rlog, rlat);
  fd = fileopen(LEANOUT, "w");
  filewrite(fd, "/-\nB-4, Lemma L1 applied, numerical step (2026-10-10). GENERATED by computations/lean_h_cert.gp.\nFor N = 100, 200, 500, 1000, 2000, with the Lean zero gaps `B4.Cert.zero_gap_for_hN : GapFrom c_N T_N`\n(B4Certificates.lean) and A = 10^6, V = 10^4, the closed inequalities of `h_bound_of_gap` are split\ninto atomic bounds proved by LeanCert (kernel) and combined by gcongr / norm_num.\nResult `class_bound_hN`: for every real primitive χ mod q, q ≥ 3, q ≠ 8, log q ≥ T_N:\n  N π < √q · L(1, χ),\ni.e. h(−q) > N via the class number formula h = √q L(1, χ)/π (q > 4; formalized in B4ClassNumber.lean).\n-/");
  filewrite(fd, "import B4ClassBound\nimport B4Certificates\nimport LeanCert.Tactic\n\nnamespace B4.ClassCert\n\nset_option maxHeartbeats 4000000\nset_option linter.unusedSimpArgs false\nset_option linter.unusedTactic false\n");
  for(i = 1, #tab,
    N = tab[i][1]; T = tab[i][2]; c = tab[i][3];
    sT = 1 - c/T; P = c*(1 + log(2*V*A*T)/T);
    cs = lc(c); Ts = lc(T); As = lc(A); Vs = Str("((", V, " : ℕ) : ℝ)");
    \\ the six exponentials of classEps and the two of the main inequality
    exprs = [Str("Real.exp ", cs),
             Str("Real.exp (", cs, " * Real.log (", As, " * ", Ts, ") / ", Ts, ")"),
             Str("Real.exp (", cs, " / ", Ts, " * Real.log ", Vs, ")"),
             Str("Real.exp (-(1 - ", cs, " / ", Ts, ") * Real.log (", As, " * ", Ts, "))"),
             Str("Real.exp (", cs, " * (1 + Real.log (2 * ", Vs, " * ", As, " * ", Ts, ") / ", Ts, "))"),
             Str("Real.exp (-(1 - ", cs, " / ", Ts, ") * Real.log ", Vs, ")")];
    vals = [exp(c), exp(c*log(A*T)/T), exp(c/T*log(V)), exp(-sT*log(A*T)), exp(P), exp(-sT*log(V))];
    rlog = rup(log(2*V*A*T));
    filewrite(fd, Str("theorem lg_", N, " : Real.log (2 * ", Vs, " * ", As, " * ", Ts, ") ≤ (", rlog, " : ℝ) := by"));
    filewrite(fd, "  simp only [Nat.cast_ofNat]; leancert (trust := kernel)\n");
    vals[5] = exp(c*(1 + rlog/T));
    rlat = rup(log(A*T));
    filewrite(fd, Str("theorem lgat_", N, " : Real.log (", As, " * ", Ts, ") ≤ (", rlat, " : ℝ) := by"));
    filewrite(fd, "  leancert (trust := kernel)\n");
    vals[2] = exp(c*rlat/T);
    ups = vector(6, k, rup(vals[k]));
    for(k = 1, 6,
      filewrite(fd, Str("theorem u", k, "_", N, " : ", exprs[k], " ≤ (", ups[k], " : ℝ) := by"));
      if(k == 2,
        filewrite(fd, Str("  calc _ ≤ Real.exp (", cs, " * (", rlat, " : ℝ) / ", Ts, ") := by"));
        filewrite(fd, Str("        apply Real.exp_le_exp.mpr; have := lgat_", N, "; gcongr"));
        filewrite(fd, "    _ ≤ _ := by leancert (trust := kernel)\n"); next);
      if(k == 5,
        filewrite(fd, Str("  calc _ ≤ Real.exp (", cs, " * (1 + (", rlog, " : ℝ) / ", Ts, ")) := by"));
        filewrite(fd, Str("        apply Real.exp_le_exp.mpr; have := lg_", N, "; gcongr"));
        filewrite(fd, "    _ ≤ _ := by leancert (trust := kernel)\n"),
        filewrite(fd, "  (try simp only [Nat.cast_ofNat]); leancert (trust := kernel)\n")));
    eu = ups[1]*(ups[2]*ups[3]/(c*A) + 4*ups[4]) + ups[5]/(c*A) + 4*ups[6]*ups[5] + ups[5]/(A*T);
    filewrite(fd, Str("theorem eps_", N, " : B4.classEps ", cs, " ", Ts, " ", As, " ", Vs, " ≤ (", eu, " : ℝ) := by"));
    filewrite(fd, "  unfold B4.classEps B4.classP");
    filewrite(fd, Str("  have h1 := u1_", N, "; have h2 := u2_", N, "; have h3 := u3_", N));
    filewrite(fd, Str("  have h4 := u4_", N, "; have h5 := u5_", N, "; have h6 := u6_", N));
    filewrite(fd, Str("  calc _ ≤ (", ups[1], " : ℝ) * ((", ups[2], " : ℝ) * (", ups[3], " : ℝ) / (", cs, " * ", As, ") + 4 * (", ups[4], " : ℝ)) +"));
    filewrite(fd, Str("        (", ups[5], " : ℝ) / (", cs, " * ", As, ") + 4 * (", ups[6], " : ℝ) * (", ups[5], " : ℝ) + (", ups[5], " : ℝ) / (", As, " * ", Ts, ") := by"));
    filewrite(fd, "          gcongr");
    filewrite(fd, "    _ = _ := by norm_num\n");
    \\ lower bounds for exp(-P) and exp(T/2)
    l = [rdown(exp(-c*(1 + rlog/T))), rdown(exp(T/2))];
    filewrite(fd, Str("theorem l1_", N, " : (", l[1], " : ℝ) ≤ Real.exp (-(", cs, " * (1 + Real.log (2 * ", Vs, " * ", As, " * ", Ts, ") / ", Ts, "))) := by"));
    filewrite(fd, Str("  calc (", l[1], " : ℝ) ≤ Real.exp (-(", cs, " * (1 + (", rlog, " : ℝ) / ", Ts, "))) := by leancert (trust := kernel)"));
    filewrite(fd, Str("    _ ≤ _ := by apply Real.exp_le_exp.mpr; have := lg_", N, "; gcongr\n"));
    filewrite(fd, Str("theorem l2_", N, " : (", l[2], " : ℝ) ≤ Real.exp (", Ts, " / 2) := by"));
    filewrite(fd, "  leancert (trust := kernel)\n");
    rhs = (1 - eu)*c*l[1]*l[2]/T;
    printf("N = %d: eps <= %.6e, lower bound %.6f vs N pi = %.6f (log margin %.5f)\n", N, eu, rhs, N*Pi, log(rhs/(N*Pi)));
    filewrite(fd, Str("theorem eps_lt_", N, " : B4.classEps ", cs, " ", Ts, " ", As, " ", Vs, " < 1 :="));
    filewrite(fd, Str("  (eps_", N, ").trans_lt (by norm_num)\n"));
    filewrite(fd, Str("theorem main_", N, " : (", N, " : ℝ) * Real.pi < (1 - B4.classEps ", cs, " ", Ts, " ", As, " ", Vs, ") *"));
    filewrite(fd, Str("    ", cs, " * Real.exp (-B4.classP ", cs, " ", Ts, " ", As, " ", Vs, ") * Real.exp (", Ts, " / 2) / ", Ts, " := by"));
    filewrite(fd, Str("  have he := eps_", N, "; have hl1 := l1_", N, "; have hl2 := l2_", N));
    filewrite(fd, "  have hpi := Real.pi_lt_d6");
    filewrite(fd, Str("  have hpos : 0 < 1 - B4.classEps ", cs, " ", Ts, " ", As, " ", Vs, " := by linarith [eps_lt_", N, "]"));
    filewrite(fd, "  unfold B4.classP at *");
    filewrite(fd, Str("  calc (", N, " : ℝ) * Real.pi < (", N, " : ℝ) * 3.141593 := by gcongr"));
    filewrite(fd, Str("    _ ≤ (1 - (", eu, " : ℝ)) * ", cs, " * (", l[1], " : ℝ) * (", l[2], " : ℝ) / ", Ts, " := by norm_num"));
    filewrite(fd, "    _ ≤ _ := by");
    filewrite(fd, "        gcongr");
    filewrite(fd, "");
    filewrite(fd, Str("/-- **h > ", N, "** (via the class number formula): `", N, " π < √q L(1, χ)` for `log q ≥ ", T, "`. -/"));
    filewrite(fd, Str("theorem class_bound_h", N, " : ∀ (q : ℕ) [NeZero q], 3 ≤ q → q ≠ 8 → ∀ (χ : DirichletCharacter ℂ q),"));
    filewrite(fd, Str("    (∀ x : ZMod q, (χ x).im = 0) → χ.IsPrimitive → χ ≠ 1 → ", Ts, " ≤ Real.log q →"));
    filewrite(fd, Str("    (", N, " : ℝ) * Real.pi < Real.sqrt q * (DirichletCharacter.LFunction χ 1).re :="));
    filewrite(fd, Str("  B4.h_bound_of_gap (V := ", V, ") (by norm_num) (by norm_num) (by norm_num)"));
    filewrite(fd, Str("    (Real.exp_one_lt_d9.le.trans (by norm_num)) (by norm_num) B4.Cert.zero_gap_for_h", N));
    filewrite(fd, Str("    eps_lt_", N, " main_", N, "\n"));
    filewrite(fd, Str("#print axioms class_bound_h", N, "\n")));
  filewrite(fd, "end B4.ClassCert");
  fileclose(fd);
  print("LEAN H CERT DONE");
  return(0);
};

run();
