\\ Post-processing for qsieve: decide h(-d) <= N for the residual (uncertified) d.
\\ Unconditional:
\\   * d < 2*10^10: qfbclassno (Shanks; documented as unconditionally correct below 2.10^10);
\\   * larger d: classno_upto, the subgroup of the class group generated by the prime forms of the
\\     split and ramified primes p <= sqrt(d/3), built until it has N+1 elements (then h > N) or
\\     until the primes run out (then it is the whole group, so h = its order).
\\ Why the primes p <= sqrt(d/3) generate: every class has a reduced form (a,b,c) with a <= sqrt(d/3);
\\ it corresponds to a primitive ideal of norm a, whose prime factors have norm p | a (split or
\\ ramified; inert primes cannot divide a primitive ideal's norm). Each class has exactly one reduced
\\ form, and qfbcomp returns reduced forms, so distinct (a,b) count distinct classes.
\\ Parameters: environment variables QS_DIR, QS_N, QS_NPROC (or globals set by a wrapper before read).
\\ Run: QS_DIR=runs/x QS_N=100 QS_NPROC=12 gp -q postproc.gp < /dev/null
\\ Writes QS_DIR/found.txt (lines "d h") and prints a summary line "POSTPROC DONE ...".
\\ A wrapper may set NO_RUN = 1 before read() to load the functions only (postproc_test.gp).

if(type(QS_DIR) != "t_STR", QS_DIR = if(getenv("QS_DIR"), getenv("QS_DIR"), "."));
if(type(QS_N) != "t_INT", QS_N = if(getenv("QS_N"), eval(getenv("QS_N")), 100));
if(type(QS_NPROC) != "t_INT", QS_NPROC = if(getenv("QS_NPROC"), eval(getenv("QS_NPROC")), 12));

\\ key of a reduced form of discriminant -d: (a, b) determines c
qkey(f) = [component(f, 1), component(f, 2)];

\\ min(h(-d), N+1) for a fundamental discriminant -d, d > 4 (see the header for the proof).
\\ All Map/List updates stay inside this function: GP passes Map and List arguments by value.
classno_upto(d, N) = {
  my(D = -d, S = Map(), G = List(), e, g, gk, nG, y, pmax = sqrtint(d \ 3));
  \\ qfbprimeform need not return a reduced form: reduce before using it as a key
  e = qfbred(qfbprimeform(D, 1));
  listput(G, e);
  mapput(S, qkey(e), 1);
  forprime(p = 2, pmax,
    if(kronecker(D, p) != -1,
      g = qfbred(qfbprimeform(D, p));
      if(!mapisdefined(S, qkey(g)),
        \\ <G, g> = union of the cosets G g^k, k = 0..m-1, m minimal with g^m in G;
        \\ these cosets are disjoint from G and from each other, which is checked
        nG = #G;
        gk = g;
        while(!mapisdefined(S, qkey(gk)),
          for(i = 1, nG,
            y = qfbcomp(G[i], gk);
            if(mapisdefined(S, qkey(y)), error("classno_upto: coset not disjoint, d = ", d));
            listput(G, y);
            mapput(S, qkey(y), 1));
          if(#G > N, return(N + 1));
          gk = qfbcomp(gk, g)))));
  return(#G);
};

classno_exact(d, N) = {
  if(d <= 4, return(1));
  if(d < 2*10^10, return(qfbclassno(-d)));
  return(classno_upto(d, N));
};

postproc() = {
  my(fd = fileopen(Str(QS_DIR, "/found.txt"), "w"), v, d, h, nres = 0, nfund = 0, nfound = 0);
  for(w = 0, QS_NPROC - 1,
    v = readvec(Str(QS_DIR, "/residual.", w, ".txt"));
    for(i = 1, #v,
      d = v[i]; nres++;
      if(isfundamental(-d),
        nfund++;
        h = classno_exact(d, QS_N);
        if(h <= QS_N, nfound++; filewrite(fd, Str(d, " ", h))))));
  fileclose(fd);
  print("POSTPROC DONE: residual ", nres, ", fundamental ", nfund, ", found h <= ", QS_N, ": ", nfound);
  return(0);
};

if(type(NO_RUN) != "t_INT", postproc());
